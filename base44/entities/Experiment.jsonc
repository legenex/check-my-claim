{
  "description": "Lead-generation experiments / interactive tools hosted on the site.",
  "name": "Experiment",
  "type": "object",
  "properties": {
    "author_name": {
      "default": "Check My Claim",
      "type": "string"
    },
    "build_status": {
      "default": "planned",
      "enum": [
        "planned",
        "in_progress",
        "beta",
        "live"
      ],
      "type": "string"
    },
    "category": {
      "enum": [
        "Estimator",
        "Simulator",
        "Analyzer",
        "Calculator",
        "Countdown",
        "Predictor",
        "Generator",
        "Map",
        "Community",
        "Ticker",
        "Other"
      ],
      "type": "string"
    },
    "clicks": {
      "default": 0,
      "type": "number"
    },
    "config": {
      "description": "Free-form JSON for tool-specific settings. For claim_estimator: auto_advance_ms, show_next_back_buttons, results_gating_mode (always_show | require_opt_in | never_show), opt_in_gate_headline, opt_in_gate_subheadline, opt_in_gate_bullets[], opt_in_submit_label, opt_in_tcpa_html, opt_in_partners_url, post_optin_reveal_animation, post_optin_uplift_min_pct, post_optin_uplift_max_pct, footer_show_full_disclaimer.",
      "type": "object"
    },
    "disclaimer_short": {
      "default": "This is an estimator/educational tool, not legal advice and not a guarantee of outcome.",
      "type": "string"
    },
    "experiment_type": {
      "enum": [
        "claim_estimator",
        "adjuster_simulator",
        "letter_analyzer",
        "lifestyle_calculator",
        "crash_clock",
        "injury_predictor",
        "letter_generator",
        "state_map",
        "case_index",
        "settlement_ticker",
        "other"
      ],
      "type": "string"
    },
    "featured_image_alt": {
      "type": "string"
    },
    "featured_image_url": {
      "type": "string"
    },
    "hero_headline": {
      "type": "string"
    },
    "hero_subheadline": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "is_featured": {
      "default": false,
      "type": "boolean"
    },
    "meta_description": {
      "type": "string"
    },
    "meta_title": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "primary_cta_text": {
      "default": "Connect With a Vetted Attorney",
      "type": "string"
    },
    "primary_cta_url": {
      "default": "https://qualify.checkmyclaim.co/s/mva",
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "type": "string"
    },
    "submissions": {
      "default": 0,
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "tracking_pixel_meta": {
      "type": "string"
    },
    "tracking_pixel_taboola": {
      "type": "string"
    },
    "utm_medium_label": {
      "type": "string"
    },
    "view_count": {
      "default": 0,
      "type": "number"
    },
    "footer_disclaimer_html": {
      "description": "Full legal footer block (Larry H. Parker / DSAR / cookies / state-specific). Per-experiment override. If empty, the runtime falls back to the shared advertorial footer.",
      "type": "string"
    },
    "social_proof_section": {
      "description": "Optional social proof / wins / testimonials / FAQ block rendered below the tool body. Mirrors the LandingPage structure.",
      "type": "object",
      "properties": {
        "show": {
          "default": true,
          "type": "boolean"
        },
        "trust_stat_1_value": {
          "default": "$50M+",
          "type": "string"
        },
        "trust_stat_1_label": {
          "default": "Recovered",
          "type": "string"
        },
        "trust_stat_2_value": {
          "default": "50,000+",
          "type": "string"
        },
        "trust_stat_2_label": {
          "default": "Total Client Wins",
          "type": "string"
        },
        "trust_stat_3_value": {
          "default": "100%",
          "type": "string"
        },
        "trust_stat_3_label": {
          "default": "Free",
          "type": "string"
        },
        "benefits_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "icon": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "recent_wins_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "string"
              },
              "name_initials": {
                "type": "string"
              },
              "age": {
                "type": "number"
              },
              "location": {
                "type": "string"
              }
            }
          }
        },
        "guarantee_title": {
          "default": "Our Attorneys Don't Get Paid Unless You Do",
          "type": "string"
        },
        "guarantee_bullets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "testimonials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "quote": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "time_ago": {
                "type": "string"
              },
              "rating": {
                "type": "number"
              },
              "initials": {
                "type": "string"
              }
            }
          }
        },
        "faq_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "title",
    "slug",
    "path",
    "experiment_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "status": "published"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}