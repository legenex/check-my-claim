{
  "name": "SurveyField",
  "type": "object",
  "description": "Global field library shared across all surveys.",
  "properties": {
    "key": {
      "type": "string",
      "description": "snake_case unique key"
    },
    "label": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "enum",
        "boolean",
        "date",
        "email",
        "phone",
        "url",
        "json"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "demographics",
        "event",
        "qualify",
        "contact",
        "routing",
        "computed"
      ]
    },
    "allowed_values": {
      "type": "array",
      "description": "For enum type: array of { value, label, icon? }",
      "items": {
        "type": "object"
      }
    },
    "description": {
      "type": "string"
    },
    "default_value": {
      "type": "string"
    },
    "computed": {
      "type": "boolean",
      "default": false,
      "description": "True if set by a step like lookup, script, or smart_date"
    },
    "source_step_id": {
      "type": "string",
      "description": "Optional FK to SurveyStep that sets this field"
    }
  },
  "required": [
    "key",
    "label",
    "type",
    "category"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}