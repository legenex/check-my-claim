{
  "name": "ContactForm",
  "type": "object",
  "description": "Lead capture forms used at quiz results steps.",
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "title": {
      "type": "string"
    },
    "form_type": {
      "type": "string",
      "enum": [
        "qualified",
        "disqualified",
        "callback",
        "generic"
      ],
      "default": "generic"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field_key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "placeholder": {
            "type": "string"
          },
          "help_text": {
            "type": "string"
          },
          "width": {
            "type": "string",
            "enum": [
              "full",
              "half",
              "third"
            ],
            "default": "full"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For select/checkbox field types"
          }
        }
      }
    },
    "tcpa_enabled": {
      "type": "boolean",
      "default": false
    },
    "tcpa_text": {
      "type": "string"
    },
    "trustedform_enabled": {
      "type": "boolean",
      "default": false
    },
    "trustedform_field_id": {
      "type": "string",
      "default": "xxTrustedFormCertUrl"
    },
    "submit_button_label": {
      "type": "string",
      "default": "Submit"
    },
    "success_redirect_url": {
      "type": "string"
    },
    "disclaimer_html": {
      "type": "string"
    },
    "show_personal_info_guarantee": {
      "type": "boolean",
      "default": false
    },
    "submit_webhook_url": {
      "type": "string"
    },
    "submit_webhook_headers": {
      "type": "object",
      "description": "Key/value map of headers to send with webhook POST"
    },
    "submit_webhook_body_template": {
      "type": "string",
      "description": "JSON template with {{field_key}} placeholders"
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string",
            "enum": [
              "on_render",
              "on_submit_success",
              "on_submit_error"
            ]
          },
          "code": {
            "type": "string"
          },
          "is_enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}