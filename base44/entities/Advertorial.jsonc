{
  "name": "Advertorial",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "status": "published"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "title": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "subheadline": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string",
      "description": "Uppercase eyebrow line above the headline. Shown in royal blue."
    },
    "slug": {
      "type": "string"
    },
    "ad_label": {
      "type": "string",
      "description": "Short ad_label param threaded into CTA URLs."
    },
    "pull_quote": {
      "type": "string",
      "description": "Pull quote rendered as a styled blockquote in the article."
    },
    "length_classification": {
      "type": "string",
      "enum": [
        "short_form",
        "long_form"
      ],
      "default": "short_form"
    },
    "category": {
      "type": "string",
      "enum": [
        "Rideshare",
        "Pedestrian/Cyclist",
        "Listicle",
        "Personal Narrative",
        "Urgency",
        "Anti-Lawyer",
        "Pride and Pain",
        "Other"
      ]
    },
    "author_name": {
      "type": "string",
      "default": "Check My Claim Editorial Team"
    },
    "author_role": {
      "type": "string",
      "default": "Consumer Advocacy Desk"
    },
    "published_date": {
      "type": "string",
      "format": "date"
    },
    "featured_image_url": {
      "type": "string"
    },
    "featured_image_alt": {
      "type": "string"
    },
    "featured_image_caption": {
      "type": "string"
    },
    "secondary_image_url": {
      "type": "string"
    },
    "secondary_image_alt": {
      "type": "string"
    },
    "secondary_image_caption": {
      "type": "string"
    },
    "body_content": {
      "type": "string",
      "description": "Full article body in markdown. Use [CTA_INLINE_1], [CTA_INLINE_2], [CTA_INLINE_3], [MID_IMAGE] markers."
    },
    "inline_images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "soft_cta_text_1": {
      "type": "string"
    },
    "soft_cta_text_2": {
      "type": "string"
    },
    "soft_cta_text_3": {
      "type": "string"
    },
    "primary_cta_text": {
      "type": "string",
      "default": "Start Your Free 30-Second Claim Check"
    },
    "primary_cta_url": {
      "type": "string",
      "default": "https://qualify.checkmyclaim.co/s/mva"
    },
    "phone_number": {
      "type": "string",
      "default": "(844) 840-6905"
    },
    "estimated_reading_time": {
      "type": "number"
    },
    "word_count": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "meta_description": {
      "type": "string"
    },
    "meta_title": {
      "type": "string"
    },
    "tracking_pixel_meta": {
      "type": "string"
    },
    "tracking_pixel_taboola": {
      "type": "string"
    },
    "payout": {
      "type": "number"
    },
    "utm_medium_label": {
      "type": "string"
    },
    "traffic_source_label": {
      "type": "string"
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "clicks": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "headline",
    "slug",
    "status"
  ]
}