{
  "name": "SurveyTheme",
  "type": "object",
  "description": "Appearance presets for surveys.",
  "properties": {
    "name": {
      "type": "string"
    },
    "is_preset": {
      "type": "boolean",
      "default": false
    },
    "tokens": {
      "type": "object",
      "description": "Design tokens: bg_0, bg_1, bg_2, container_bg, container_border, container_radius, button_primary_bg, button_primary_text, button_answer_style (filled/outlined/ghost), button_radius, button_hover_effect (lift/glow/scale), progress_color, progress_height, progress_style (solid/striped/animated), font_display, font_body, font_size_base, heading_weight, body_weight"
    },
    "custom_css": {
      "type": "string"
    },
    "background_pattern": {
      "type": "string",
      "enum": [
        "none",
        "plus-grid",
        "dots",
        "lines"
      ],
      "default": "none"
    },
    "background_pattern_opacity": {
      "type": "number",
      "default": 0.3
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}