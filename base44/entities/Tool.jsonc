{
  "name": "Tool",
  "type": "object",
  "description": "Attorney Match Engine and future public funnel tools. Fully CMS-driven, editable from admin.",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "status": "live"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL-safe identifier, e.g. attorney-match"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "live",
        "paused"
      ],
      "default": "draft"
    },
    "subtype_default": {
      "type": "string",
      "enum": [
        "auto",
        "commercial",
        "rideshare"
      ],
      "default": "auto"
    },
    "hero_eyebrow": {
      "type": "string"
    },
    "hero_headline": {
      "type": "string"
    },
    "hero_subhead": {
      "type": "string"
    },
    "hero_lead": {
      "type": "string",
      "description": "Two paragraphs of body copy, separated by \\n\\n"
    },
    "key_facts": {
      "type": "array",
      "description": "Up to 5 numbered key facts",
      "items": {
        "type": "string"
      }
    },
    "quiz_questions": {
      "type": "array",
      "description": "Array of quiz question objects: {id, question, help_text, type (single_select|dropdown), options: [{id, label}]}",
      "items": {
        "type": "object"
      }
    },
    "attorney_type_map": {
      "type": "array",
      "description": "Lookup rows: {accident_type, surgery (any|had_surgery|surgery_recommended|no_surgery), label}",
      "items": {
        "type": "object"
      }
    },
    "statute_map": {
      "type": "array",
      "description": "Lookup rows: {when_ids: [array of when values], status (GREEN|YELLOW|RED), label}",
      "items": {
        "type": "object"
      }
    },
    "match_criteria_lines": {
      "type": "array",
      "description": "4 templated strings using {insurer_class}, {liability_complexity}, {state}, {attorney_type}",
      "items": {
        "type": "string"
      }
    },
    "match_reveal_headline": {
      "type": "string"
    },
    "match_reveal_subhead": {
      "type": "string"
    },
    "cta_button_text": {
      "type": "string"
    },
    "cta_subline": {
      "type": "string"
    },
    "trust_strip": {
      "type": "string"
    },
    "call_tracking_number": {
      "type": "string",
      "description": "Falls back to site default (844) 840-6905 when empty"
    },
    "lead_endpoint_source": {
      "type": "string",
      "default": "tools_match"
    }
  },
  "required": [
    "slug",
    "name",
    "status"
  ]
}