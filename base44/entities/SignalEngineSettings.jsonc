{
  "name": "SignalEngineSettings",
  "type": "object",
  "properties": {
    "alert_recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email addresses"
    },
    "alert_threshold_composite_score": {
      "type": "number",
      "default": 60
    },
    "urgent_threshold_composite_score": {
      "type": "number",
      "default": 80
    },
    "digest_email_enabled": {
      "type": "boolean",
      "default": true
    },
    "digest_send_time": {
      "type": "string",
      "default": "08:00"
    },
    "digest_recipients": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "slack_webhook_url": {
      "type": "string"
    },
    "sms_alert_recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Phone numbers for urgent alerts only"
    },
    "notification_quiet_hours_start": {
      "type": "string",
      "default": "22:00"
    },
    "notification_quiet_hours_end": {
      "type": "string",
      "default": "06:00"
    },
    "scoring_weights": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "number",
          "default": 0.3
        },
        "volume": {
          "type": "number",
          "default": 0.2
        },
        "wealth": {
          "type": "number",
          "default": 0.2
        },
        "urgency": {
          "type": "number",
          "default": 0.2
        },
        "competition": {
          "type": "number",
          "default": 0.1
        }
      }
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "compliance_acknowledgment": {
      "type": "boolean",
      "default": false,
      "description": "Admin must acknowledge DPPA/anti-solicitation rules before enabling"
    }
  },
  "required": [
    "alert_recipients"
  ]
}